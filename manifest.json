{
  "manifest_version": 3,
  "name": "Tab Audio Recorder",
  "version": "1.0.0",
  "description": "Capture and save audio from the current browser tab (YouTube, Meet, Teams, Zoom in-browser).",
  "permissions": [
    "tabCapture",
    "activeTab",
    "offscreen",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "ws://*/*",
    "wss://*/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Audio Recorder"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
